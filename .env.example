# Zkopírujte do .env pro lokální vývoj (netlify dev). Na Netlify nastavte stejné proměnné
# v Site settings → Environment variables. Soubor .env se nikdy necommituje.

# --- Klientská část (viditelné v prohlížeči!) ---
# Zapne volbu "Online kartou" v objednávkovém formuláři
PUBLIC_ONLINE_PAYMENTS=false

# --- Comgate (jen serverové funkce, NIKDY s předponou PUBLIC_) ---
# ID obchodu (propojení) v Comgate; výchozí 524485 (starší název COMGATE_MERCHANT se stále čte)
COMGATE_MERCHANT_ID=524485
# Heslo pro komunikaci na pozadí – Klientský portál → Nastavení obchodů → Připojení obchodů → propojení 524485. TAJNÉ.
COMGATE_SECRET=
# "false" až po schválení ostrého provozu Comgatem
COMGATE_TEST=true
# (volitelné) veřejná adresa webu pro návratové URL, výchozí https://cukrarstviblahutovi.cz
# SITE_URL=https://cukrarstviblahutovi.cz

# --- Potvrzovací e-maily zákazníkům přes Resend (jen serverové funkce, TAJNÉ) ---
# Bez klíče posílá potvrzení Apps Script přes Google (nová doména to má dočasně zablokované – chyba 69585).
# S klíčem Apps Script potvrzení jen sestaví a odešle ho funkce pohoda-webhook přes Resend.
RESEND_API_KEY=
# Adresa odesílatele na doméně ověřené v Resendu (výchozí objednavky@cukrarstviblahutovi.cz)
# MAIL_FROM=objednavky@cukrarstviblahutovi.cz

# --- POHODA ---
POHODA_ICO=
POHODA_RATE_VAT=low
# Jen pro integrations/pohoda/send-to-pohoda.mjs (přímé odeslání na mServer)
POHODA_MSERVER_URL=
POHODA_USER=
POHODA_PASSWORD=
# "false" vypne kontrolu duplicity čísla objednávky (výchozí: zapnuto)
POHODA_CHECK_DUPLICITY=true
