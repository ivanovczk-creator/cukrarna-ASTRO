---
import Layout from '../layouts/Layout.astro';

const districts = [
  "Ostrava", "Karviná", "Opava", "Bohumín", "Havířov", "Orlová", "Hlučín", "Rychvald"
];
---

<Layout 
	title="Velkoobchod zákusků a catering | Ostrava, Karviná, Opava" 
	description="Pravidelné závozy čerstvých zákusků a dortů pro kavárny, restaurace a firemní akce. Poctivá řemeslná výroba."
>
	<main class="bg-slate-50 min-h-screen">
		<section class="py-24 px-4 bg-[#0a192f] text-white text-center relative overflow-hidden font-bold">
			<div class="max-w-4xl mx-auto relative z-10">
				<h1 class="text-4xl md:text-6xl font-serif mb-6 italic text-[#d4af37] font-bold leading-tight">B2B Spolupráce a Velkoobchod</h1>
				<p class="text-xl opacity-90 leading-relaxed font-serif italic">
					Hledáte spolehlivého partnera pro vaši kavárnu, restauraci nebo firemní akce? 
					Zajistíme pravidelný závoz poctivých zákusků přímo z naší výrobny.
				</p>
			</div>
		</section>

		<section class="py-12 px-4 max-w-7xl mx-auto">
			<div class="bg-white rounded-[2.5rem] p-8 shadow-sm border-2 border-[#d4af37]/20 flex flex-col md:flex-row items-center justify-between gap-8 transition-all hover:shadow-md">
				<div class="text-center md:text-left">
					<h3 class="text-2xl font-serif text-[#0a192f] italic font-bold mb-2">Zákaznický portál pro partnery</h3>
					<p class="text-slate-600 font-bold max-w-md">Jste již naším odběratelem? Zadejte svou objednávku přímo do výroby v našem systému.</p>
				</div>
				<a 
					href="https://objednavky.cukrarstviblahutovi.cz/login" 
					target="_blank" 
					rel="noopener noreferrer"
					class="whitespace-nowrap bg-[#0a192f] text-[#d4af37] px-10 py-5 rounded-2xl font-bold uppercase tracking-widest text-xs hover:bg-[#d4af37] hover:text-[#0a192f] transition-all shadow-lg hover:scale-105 active:scale-95"
				>
					Vstoupit do objednávek
				</a>
			</div>
		</section>

		<section class="py-16 px-4 max-w-7xl mx-auto font-bold">
			<div class="grid lg:grid-cols-2 gap-16 items-start">
				<div class="text-navy-900">
					<h2 class="text-3xl font-serif mb-6 text-[#0a192f] italic font-bold">Zásobování v Moravskoslezském kraji</h2>
					<p class="text-slate-700 mb-8 text-lg">
						Naše cukrářství disponuje vlastní chlazenou autodopravou, díky které garantujeme maximální čerstvost. 
						Zákusky a dorty zavážíme několikrát týdně do těchto lokalit:
					</p>
					
					<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
						{districts.map(city => (
							<div class="bg-white border-2 border-slate-200 p-3 rounded-2xl text-center shadow-sm">
								<span class="text-[#0a192f] font-bold text-sm tracking-wide">{city}</span>
							</div>
						))}
					</div>

					<div class="space-y-6">
						<div class="flex items-start gap-4">
							<div class="bg-[#d4af37]/20 p-3 rounded-full text-[#735c1e] font-bold">✔</div>
							<div>
								<h4 class="font-bold text-[#0a192f] uppercase text-xs tracking-widest mb-1">Individuální velkoobchodní ceník</h4>
								<p class="text-slate-600 text-sm">Nastavíme podmínky na míru vašemu odběru.</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="bg-[#d4af37]/20 p-3 rounded-full text-[#735c1e] font-bold">✔</div>
							<div>
								<h4 class="font-bold text-[#0a192f] uppercase text-xs tracking-widest mb-1">Flexibilní závozy</h4>
								<p class="text-slate-600 text-sm">Závozy plánujeme tak, aby vaše vitrína byla vždy plná.</p>
							</div>
						</div>
					</div>
				</div>

				<div class="bg-white p-8 md:p-12 rounded-[3rem] shadow-2xl border border-slate-100">
					<h3 class="text-3xl font-serif mb-8 text-center text-[#0a192f] italic font-bold">Nezávazná poptávka</h3>
					
					<form 
						name="b2b-poptavka" 
						method="POST" 
						data-netlify="true" 
						action="/dekujeme"
						class="space-y-5"
					>
						<input type="hidden" name="form-name" value="b2b-poptavka" />

						<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
							<div>
								<label id="label-firma" class="block text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-2 ml-2">Název firmy</label>
								<input type="text" name="firma" aria-labelledby="label-firma" placeholder="Moje firma s.r.o." required class="w-full p-4 rounded-2xl bg-slate-50 border-none focus:ring-2 focus:ring-[#d4af37] outline-none font-bold" />
							</div>
							<div>
								<label id="label-ico" class="block text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-2 ml-2">IČO</label>
								<input type="text" name="ico" aria-labelledby="label-ico" placeholder="12345678" class="w-full p-4 rounded-2xl bg-slate-50 border-none focus:ring-2 focus:ring-[#d4af37] outline-none font-bold" />
							</div>
						</div>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
							<div>
								<label id="label-email" class="block text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-2 ml-2">E-mail</label>
								<input type="email" name="email" aria-labelledby="label-email" placeholder="vas@email.cz" required class="w-full p-4 rounded-2xl bg-slate-50 border-none focus:ring-2 focus:ring-[#d4af37] outline-none font-bold" />
							</div>
							<div>
								<label id="label-tel" class="block text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-2 ml-2">Telefon</label>
								<input type="tel" name="telefon" aria-labelledby="label-tel" placeholder="+420 123 456 789" required class="w-full p-4 rounded-2xl bg-slate-50 border-none focus:ring-2 focus:ring-[#d4af37] outline-none font-bold" />
							</div>
						</div>
						<div>
							<label id="label-lokalita" class="block text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-2 ml-2">Lokalita závozu</label>
							<select name="lokalita" aria-labelledby="label-lokalita" required class="w-full p-4 rounded-2xl bg-slate-50 border-none focus:ring-2 focus:ring-[#d4af37] outline-none font-bold text-slate-700">
								<option value="">Vyberte město</option>
								{districts.map(city => <option value={city}>{city}</option>)}
								<option value="jine">Jiná lokalita</option>
							</select>
						</div>
						<div>
							<label id="label-msg" class="block text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-2 ml-2">Zpráva / Poptávané množství</label>
							<textarea name="zprava" aria-labelledby="label-msg" placeholder="Mám zájem o pravidelný odběr..." rows="4" class="w-full p-4 rounded-2xl bg-slate-50 border-none focus:ring-2 focus:ring-[#d4af37] outline-none font-bold"></textarea>
						</div>
						
						<label for="b2b-consent" class="flex items-start gap-3 cursor-pointer text-sm text-slate-700 font-bold leading-snug">
							<input id="b2b-consent" type="checkbox" name="Souhlas-VOP-GDPR" value="ano" required autocomplete="off" class="mt-0.5 h-4 w-4 shrink-0 accent-[#d4af37] cursor-pointer" />
							<span>
								Souhlasím se <a href="/obchodni-podminky" target="_blank" rel="noopener noreferrer" class="underline text-[#735c1e] hover:text-[#0a192f]">Všeobecnými obchodními podmínkami</a>
								a beru na vědomí <a href="/ochrana-osobnich-udaju" target="_blank" rel="noopener noreferrer" class="underline text-[#735c1e] hover:text-[#0a192f]">Zásady ochrany osobních údajů</a>.
							</span>
						</label>

						<button type="submit" class="w-full bg-[#0a192f] text-[#d4af37] py-5 rounded-2xl font-bold uppercase tracking-[0.2em] text-xs hover:bg-[#d4af37] hover:text-[#0a192f] transition-all shadow-xl active:scale-95">
							Odeslat poptávku
						</button>
					</form>
				</div>
			</div>
		</section>
	</main>
</Layout>

