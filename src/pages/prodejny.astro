---
import Layout from '../layouts/Layout.astro';
import ReservationForm from '../components/ReservationForm.tsx';

const shops = [
  {
    city: 'Píšť',
    name: 'Sídlo firmy & Výroba',
    address: 'Opavská 218/101, 747 18 Píšť',
    phone: '+420 602 323 788',
    hours: [
      'Po–Pá: 6:00 – 15:00',
      'So–Ne: Dle domluvy'
    ],
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Cukrarstvi+Blahutovi+Pist',
    isHeadquarters: true
  },
  {
    city: 'Petřvald',
    name: 'Cukrárna Petřvald',
    address: 'Šenovská 1, 735 41 Petřvald',
    phone: '+420 778 157 857',
    hours: [
      'Út–Ne: 9:00 – 17:00',
      'Po: Zavřeno'
    ],
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Cukrarna+Blahutovi+Petrvald'
  },
  {
    city: 'Karviná',
    name: 'Cukrárna Karviná',
    address: 'tř. Těreškovové 2233/28, 734 01 Karviná-Ráj',
    phone: '+420 778 157 867',
    hours: [
      'Po–Pá: 9:00 – 17:00',
      'So: 8:00 – 12:00',
      'Ne: Zavřeno'
    ],
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Cukrarna+Blahutovi+Karvina'
  },
  {
    city: 'Ostrava',
    name: 'Cukrárna Ostrava Zábřeh',
    address: 'Výškovická 116a, 700 30 Ostrava-jih',
    phone: '+420 775 271 101',
    hours: [
      'Po–Pá: 9:00 – 17:00',
      'So: 9:00 – 12:00',
      'Ne: Zavřeno'
    ],
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Cukrarna+Blahutovi+Ostrava'
  }
];
---

<Layout 
	title="Naše prodejny a výroba | Cukrářství Blahutovi - Petřvald, Karviná, Ostrava, Píšť" 
	description="Navštivte naše cukrárny v Petřvaldě, Karviné a Ostravě. Sídlo a výroba v Píšti. Nabízíme čerstvé zákusky, dorty na objednávku a výběrovou kávu."
>
	<header class="bg-[#0a192f] text-white sticky top-0 z-50 border-b-2 border-[#d4af37]">
		<div class="max-w-7xl mx-auto px-4 h-20 flex justify-between items-center relative font-bold">
			<a href="/" class="group no-underline">
				<strong class="text-xl md:text-2xl font-serif text-[#d4af37] group-hover:text-white transition-colors">Cukrářství Blahutovi</strong>
			</a>

			<nav id="nav-menu" class="hidden lg:flex gap-6 uppercase text-[10px] font-bold tracking-widest text-white/90">
				<a href="/dorty" class="hover:text-[#d4af37] py-2">Dorty</a>
				<a href="/zakusky" class="hover:text-[#d4af37] py-2">Zákusky</a>
				<a href="/zapichy" class="hover:text-[#d4af37] py-2">Zápichy</a>
				<a href="/jedly-tisk" class="hover:text-[#d4af37] py-2">Jedlý tisk</a>
				<a href="/dort-na-prani" class="hover:text-[#d4af37] py-2">Dort na přání</a>
				<a href="/prodejny" class="text-[#d4af37] py-2 font-bold underline underline-offset-8">Prodejny</a>
				<a href="/pro-firmy" class="hover:text-[#d4af37] py-2">Pro firmy</a>
			</nav>

			<div class="flex items-center gap-4">
				<ReservationForm client:load />
				<button id="menu-toggle" aria-label="Otevřít hlavní menu" class="lg:hidden text-[#d4af37] p-2 outline-none cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</div>
		</div>
	</header>

	<main class="bg-slate-50 min-h-screen">
		<section class="py-20 px-4 bg-[#0a192f] text-white text-center">
			<div class="max-w-4xl mx-auto">
				<h1 class="text-4xl md:text-6xl font-serif mb-6 italic text-[#d4af37] font-bold">Kde nás najdete</h1>
				<p class="text-xl opacity-90 leading-relaxed font-bold">
					Od výroby v Píšti až po naše cukrárny. Těšíme se na vás na čtyřech místech v kraji.
				</p>
			</div>
		</section>

		<section class="py-16 px-4 max-w-7xl mx-auto">
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				{shops.map(shop => (
					<div class={`bg-white rounded-[2.5rem] shadow-xl overflow-hidden border flex flex-col ${shop.isHeadquarters ? 'border-[#d4af37] ring-1 ring-[#d4af37]' : 'border-slate-100'}`}>
						<div class="p-8 flex-grow">
							<div class={`${shop.isHeadquarters ? 'bg-[#d4af37] text-[#0a192f]' : 'bg-[#d4af37]/10 text-[#92782a]'} w-fit px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mb-4`}>
								{shop.isHeadquarters ? 'Sídlo & Výroba' : shop.city}
							</div>
							<h2 class="text-xl font-serif mb-6 text-[#0a192f] italic font-bold leading-tight">{shop.name}</h2>
							
							<div class="space-y-6 text-slate-700 font-bold"> 
								<div class="flex items-start gap-4">
									<span class="text-[#d4af37] mt-1 shrink-0">📍</span>
									<p class="text-xs leading-relaxed font-bold">{shop.address}</p>
								</div>
								<div class="flex items-start gap-4">
									<span class="text-[#d4af37] mt-1 shrink-0">📞</span>
									<a href={`tel:${shop.phone.replace(/\s/g, '')}`} class="hover:text-[#d4af37] transition-colors font-bold text-xs">{shop.phone}</a>
								</div>
								<div class="flex items-start gap-4">
									<span class="text-[#d4af37] mt-1 shrink-0">🕒</span>
									<div class="text-xs space-y-1 font-bold">
										{shop.hours.map(line => <p>{line}</p>)}
									</div>
								</div>
							</div>
						</div>
						
						<div class="p-8 pt-0 mt-auto">
							<a 
								href={shop.mapUrl} 
								target="_blank" 
								rel="noopener noreferrer"
								class="block w-full py-3 bg-[#0a192f] text-[#d4af37] text-center rounded-2xl hover:bg-[#d4af37] hover:text-[#0a192f] transition-all uppercase text-[9px] font-bold tracking-widest shadow-md"
							>
								Naplánovat trasu v mapách
							</a>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="py-20 px-4 bg-white">
			<div class="max-w-7xl mx-auto text-center font-bold">
				<h2 class="text-3xl md:text-5xl font-serif mb-16 italic text-[#0a192f]">Více než jen sladké...</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
					<div class="flex flex-col items-center">
						<div class="w-24 h-24 bg-[#f8f5f0] rounded-full flex items-center justify-center mb-6 text-4xl shadow-inner">☕</div>
						<h3 class="text-xl font-serif mb-3 italic text-[#0a192f] font-bold">Výběrová káva</h3>
						<p class="text-slate-600 text-sm leading-relaxed">Vychutnejte si u nás čerstvě praženou kávu připravenou ke každému zákusku.</p>
					</div>
					<div class="flex flex-col items-center">
						<div class="w-24 h-24 bg-[#f8f5f0] rounded-full flex items-center justify-center mb-6 text-4xl shadow-inner">🍋</div>
						<h3 class="text-xl font-serif mb-3 italic text-[#0a192f] font-bold">Domácí limonády</h3>
						<p class="text-slate-600 text-sm leading-relaxed">Osvěžující limonády z poctivých sirupů a čerstvého ovoce.</p>
					</div>
					<div class="flex flex-col items-center">
						<div class="w-24 h-24 bg-[#f8f5f0] rounded-full flex items-center justify-center mb-6 text-4xl shadow-inner">🥪</div>
						<h3 class="text-xl font-serif mb-3 italic text-[#0a192f] font-bold">Slané občerstvení</h3>
						<p class="text-slate-600 text-sm leading-relaxed">Denně čerstvé obložené chlebíčky pro vaši rychlou svačinu.</p>
					</div>
					<div class="flex flex-col items-center">
						<div class="w-24 h-24 bg-[#f8f5f0] rounded-full flex items-center justify-center mb-6 text-4xl shadow-inner">🍦</div>
						<h3 class="text-xl font-serif mb-3 italic text-[#0a192f] font-bold">Řemeslná zmrzlina</h3>
						<p class="text-slate-600 text-sm leading-relaxed">V letní sezóně vás osvěžíme naší poctivou kopečkovou zmrzlinou.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="py-16 px-4 max-w-4xl mx-auto text-center font-bold">
			<div class="bg-white p-12 rounded-[3rem] shadow-sm border border-slate-200">
				<h3 class="text-2xl font-serif mb-4 italic text-[#0a192f] font-bold">Plánujete větší odběr?</h3>
				<p class="text-slate-700 mb-8 font-bold leading-relaxed">
					Pokud si chcete rezervovat větší množství zákusků nebo se poradit o svatebním dortu, doporučujeme volat přímo na vybranou prodejnu.
				</p>
				<div class="flex flex-wrap justify-center gap-4 font-bold">
					<ReservationForm client:load />
				</div>
			</div>
		</section>
	</main>

	<footer class="bg-[#0a192f] py-16 text-center text-white/70 text-[10px] border-t border-[#d4af37]/10 font-bold font-serif uppercase tracking-widest">
		<div class="max-w-7xl mx-auto px-4">
			<p class="mb-2 italic text-[#d4af37] text-sm normal-case font-bold">Cukrářství Blahutovi</p>
			<p class="mb-2">IČO: 76208371</p>
			<p>© {new Date().getFullYear()} — Tradiční rodinné cukrářství</p>
		</div>
	</footer>
</Layout>

<script is:inline>
	function setupMenu() {
		const btn = document.getElementById('menu-toggle');
		const nav = document.getElementById('nav-menu');
		if (btn && nav) {
			btn.onclick = (e) => {
				e.preventDefault();
				nav.classList.toggle('hidden');
				nav.classList.toggle('flex');
				nav.classList.toggle('flex-col');
				nav.classList.toggle('absolute');
				nav.classList.toggle('top-20');
				nav.classList.toggle('left-0');
				nav.classList.toggle('w-full');
				nav.classList.toggle('bg-[#0a192f]');
				nav.classList.toggle('p-6');
				nav.classList.toggle('z-50');
				nav.classList.toggle('border-b');
				nav.classList.toggle('border-[#d4af37]');
			};
		}
	}
	setupMenu();
	document.addEventListener('astro:page-load', setupMenu);
</script>
