---
import Layout from '../layouts/Layout.astro';
import { COMPANY } from '../lib/legal';
---
<Layout title="Děkujeme | Cukrářství Blahutovi">
	<main class="flex items-center justify-center min-h-[70vh] px-4 py-12 bg-slate-50">
		<div class="text-center max-w-2xl bg-white p-12 md:p-20 rounded-[3rem] shadow-xl border border-slate-100">
			<h1 id="thanks-title" class="text-4xl md:text-6xl font-serif text-[#0a192f] mb-6 italic font-bold">
				Děkujeme za zprávu!
			</h1>
			<p id="thanks-text" class="text-lg md:text-xl text-slate-700 mb-6 leading-relaxed font-bold">
				Vaši poptávku jsme v pořádku přijali. Co nejdříve se na ni podíváme a ozveme se vám zpět, abychom doladili detaily.
			</p>
			<p id="thanks-ref" class="hidden mb-6 text-sm font-bold text-slate-500"></p>
			<p class="mb-10 text-sm text-slate-500 font-bold">
				Dotazy k objednávce: <a href={`mailto:${COMPANY.email}`} class="underline text-[#92782a]">{COMPANY.email}</a>, tel. {COMPANY.phone}
			</p>
			<a href="/" class="inline-block bg-[#0a192f] text-[#d4af37] px-10 py-4 rounded-full font-bold uppercase tracking-widest text-xs hover:bg-[#d4af37] hover:text-[#0a192f] transition-all shadow-lg font-serif italic">
				Zpět na hlavní stránku
			</a>
		</div>
	</main>
</Layout>

<script>
	// Návrat z platební brány Comgate: ?platba=zaplaceno|zrusena|cekajici&refId=BL-...
	function showPaymentResult() {
		const params = new URLSearchParams(location.search);
		const status = params.get('platba');
		if (!status) return;

		const messages: Record<string, { title: string; text: string }> = {
			zaplaceno: {
				title: 'Platba proběhla úspěšně',
				text: 'Děkujeme, vaši platbu jsme přijali a objednávku zpracováváme. Potvrzení objednávky vám pošleme e-mailem.',
			},
			zrusena: {
				title: 'Platba nebyla dokončena',
				text: 'Platba byla zrušena nebo se nezdařila. Objednávku jsme přijali – můžete zaplatit při převzetí na prodejně, nebo nás kontaktujte a platbu zopakujeme.',
			},
			cekajici: {
				title: 'Platba čeká na potvrzení',
				text: 'Platbu zatím banka nepotvrdila. Jakmile ji obdržíme, dáme vám vědět e-mailem.',
			},
		};
		const message = messages[status];
		if (!message) return;

		const title = document.getElementById('thanks-title');
		const text = document.getElementById('thanks-text');
		const ref = document.getElementById('thanks-ref');
		if (title) title.textContent = message.title;
		if (text) text.textContent = message.text;

		const refId = params.get('refId');
		if (ref && refId && /^BL-\d{8}-[A-Z0-9]{4}$/.test(refId)) {
			ref.textContent = `Číslo objednávky: ${refId}`;
			ref.classList.remove('hidden');
		}
	}
	document.addEventListener('astro:page-load', showPaymentResult);
</script>

<style is:inline>
  h1 { content-visibility: auto; }
</style>
