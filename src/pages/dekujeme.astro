---
import Layout from '../layouts/Layout.astro';
import { COMPANY } from '../lib/legal';
---
<Layout title="Děkujeme | Cukrářství Blahutovi" noindex={true}>
	<main class="flex items-center justify-center min-h-[70vh] px-4 py-12 bg-zinc-50">
		<div class="text-center max-w-2xl bg-white p-12 md:p-20 rounded-[3rem] shadow-xl border border-zinc-100">
			<h1 id="thanks-title" class="text-4xl md:text-6xl font-serif text-zinc-900 mb-6 italic font-bold">
				Děkujeme za zprávu!
			</h1>
			<p id="thanks-text" role="status" aria-live="polite" class="text-lg md:text-xl text-zinc-700 mb-6 leading-relaxed font-bold">
				Vaši poptávku jsme v pořádku přijali. Co nejdříve se na ni podíváme a ozveme se vám zpět, abychom doladili detaily.
			</p>
			<p id="thanks-ref" class="hidden mb-6 text-sm font-bold text-zinc-500"></p>
			<p class="mb-10 text-sm text-zinc-500 font-bold">
				Dotazy k objednávce: <a href={`mailto:${COMPANY.email}`} class="underline text-gold-700">{COMPANY.email}</a>, tel. {COMPANY.phone}
			</p>
			<a href="/" class="inline-block bg-gold-500 text-zinc-900 px-10 py-4 rounded-full font-bold uppercase tracking-widest text-xs hover:bg-zinc-900 hover:text-gold-500 transition-all shadow-lg font-serif italic">
				Zpět na hlavní stránku
			</a>
		</div>
	</main>
</Layout>

<script>
	// Návrat z platební brány Comgate: ?platba=zaplaceno|zrusena|cekajici&refId=BL-...
	// Parametry v adrese si může zákazník změnit, proto se skutečný stav platby vždy ověřuje na serveru
	// (/api/payment-status ← push notifikace z Comgate). Úspěch se zobrazí jen při potvrzení serverem.
	import { takeOrder, trackPurchase, type PendingOrder } from '../lib/analytics';

	type Status = 'PAID' | 'PENDING' | 'CANCELLED' | 'UNKNOWN';

	const MESSAGES: Record<'PAID' | 'PENDING' | 'CANCELLED' | 'CHECKING' | 'UNVERIFIED', { title: string; text: string }> = {
		PAID: {
			title: 'Platba proběhla úspěšně',
			text: 'Děkujeme, vaši platbu kartou jsme přijali a objednávku zpracováváme. Potvrzení objednávky vám pošleme e-mailem. Zboží si vyzvednete v objednaném termínu na vybrané prodejně.',
		},
		PENDING: {
			title: 'Platba čeká na potvrzení',
			text: 'Platbu zatím banka nepotvrdila. Objednávku jsme přijali – jakmile platbu obdržíme, dáme vám vědět e-mailem.',
		},
		CANCELLED: {
			title: 'Platba nebyla dokončena',
			text: 'Platba byla zrušena nebo se nezdařila, objednávku jsme ale přijali. Ozveme se vám ohledně platby, případně můžete zaplatit při převzetí na prodejně, nebo nás kontaktujte a platbu zopakujeme.',
		},
		CHECKING: {
			title: 'Ověřujeme stav platby…',
			text: 'Chvilku strpení, zjišťujeme výsledek platby u platební brány.',
		},
		UNVERIFIED: {
			title: 'Stav platby se nepodařilo ověřit',
			text: 'Objednávku jsme přijali. Pokud platba z vašeho účtu odešla, objednávku zpracujeme a potvrdíme e-mailem. V případě pochybností nás prosím kontaktujte.',
		},
	};

	function render(kind: keyof typeof MESSAGES) {
		const message = MESSAGES[kind];
		const title = document.getElementById('thanks-title');
		const text = document.getElementById('thanks-text');
		if (title) title.textContent = message.title;
		if (text) text.textContent = message.text;
	}

	async function fetchStatus(refId: string): Promise<Status> {
		try {
			const res = await fetch(`/api/payment-status?refId=${encodeURIComponent(refId)}`, { cache: 'no-store' });
			if (!res.ok) return 'UNKNOWN';
			const data = await res.json();
			return ['PAID', 'PENDING', 'CANCELLED'].includes(data?.status) ? data.status : 'UNKNOWN';
		} catch {
			return 'UNKNOWN';
		}
	}

	const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	// GA4: událost purchase (objednávku si pamatuje CartPanel v sessionStorage; čte se jen jednou, takže se při
	// obnovení stránky nepočítá dvakrát). Platba při převzetí = hned, online platba = až po potvrzení zaplacení serverem.
	function trackOrderPurchase(order: PendingOrder | null, status?: Status) {
		if (!order) return;
		if (order.payment === 'cash' || status === 'PAID') trackPurchase(order);
	}

	async function showPaymentResult() {
		const params = new URLSearchParams(location.search);
		const hint = params.get('platba');
		const order = takeOrder();
		if (!hint) {
			// bez parametrů platby = objednávka s platbou při převzetí (i online platba, kterou se nepodařilo zahájit)
			trackOrderPurchase(order && { ...order, payment: 'cash' });
			return;
		}

		const refId = params.get('refId') ?? '';
		const validRef = /^BL-\d{8}-[A-Z0-9]{4}$/.test(refId);

		const ref = document.getElementById('thanks-ref');
		if (ref && validRef) {
			ref.textContent = `Číslo objednávky: ${refId}`;
			ref.classList.remove('hidden');
		}

		if (!validRef) {
			render(hint === 'zrusena' ? 'CANCELLED' : 'UNVERIFIED');
			return;
		}

		render('CHECKING');
		// Comgate vrací zákazníka až po předání výsledku na pozadí; kdyby push o chvilku zaostal, zkusíme to pár vteřin znovu
		const attempts = hint === 'zaplaceno' ? 5 : 2;
		let status: Status = 'UNKNOWN';
		for (let i = 0; i < attempts; i += 1) {
			status = await fetchStatus(refId);
			if (status === 'PAID' || status === 'CANCELLED') break;
			if (i < attempts - 1) await sleep(2500);
		}

		if (order && order.orderId === refId) trackOrderPurchase(order, status);

		if (status === 'PAID') render('PAID');
		else if (status === 'CANCELLED') render('CANCELLED');
		else if (status === 'PENDING') render('PENDING');
		else if (hint === 'zrusena') render('CANCELLED');
		else render('UNVERIFIED');
	}
	document.addEventListener('astro:page-load', showPaymentResult);
</script>

<style is:inline>
  h1 { content-visibility: auto; }
</style>
