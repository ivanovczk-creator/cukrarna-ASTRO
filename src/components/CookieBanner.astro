---
// Cookies lišta (CZ): „Přijmout vše“, „Odmítnout vše“, „Nastavení“. Volba se ukládá do localStorage.
// Analytika (Google Analytics) se spouští VÝHRADNĚ po udělení souhlasu s analytickými cookies.
import { LEGAL_PAGES } from '../lib/legal';
---

<div
	id="cookie-banner"
	role="dialog"
	aria-modal="false"
	aria-labelledby="cookie-banner-title"
	class="hidden fixed inset-x-0 bottom-0 z-[10000] p-3 md:p-6"
>
	<div class="max-w-4xl mx-auto bg-[#0a192f] text-white rounded-3xl shadow-2xl border border-[#d4af37]/60 p-5 md:p-7 max-h-[90vh] overflow-y-auto">
		<h2 id="cookie-banner-title" class="text-lg md:text-xl font-serif italic font-bold text-[#d4af37] mb-2">Cookies na našem webu</h2>
		<p class="text-sm leading-relaxed text-white/90">
			Nezbytné cookies a úložiště prohlížeče potřebujeme pro fungování košíku a objednávek. S vaším souhlasem používáme také
			analytické cookies (Google Analytics), které nám pomáhají web zlepšovat. Souhlas můžete kdykoli změnit v patičce webu
			(„Nastavení cookies“). Více v <a href={LEGAL_PAGES.cookies} class="underline text-[#d4af37] hover:text-white">Zásadách cookies</a>
			a <a href={LEGAL_PAGES.privacy} class="underline text-[#d4af37] hover:text-white">Zásadách ochrany osobních údajů</a>.
		</p>

		<div id="cookie-settings-panel" class="hidden mt-5 space-y-3 text-sm">
			<div class="flex items-start justify-between gap-4 bg-white/5 rounded-2xl p-4">
				<div>
					<p class="font-bold">Nezbytné</p>
					<p class="text-white/80 text-xs mt-1">Obsah košíku, volba cookies, bezpečnost a fungování objednávek. Nelze vypnout.</p>
				</div>
				<span class="shrink-0 text-xs font-bold text-[#d4af37] uppercase tracking-widest mt-1">Vždy zapnuto</span>
			</div>
			<label class="flex items-start justify-between gap-4 bg-white/5 rounded-2xl p-4 cursor-pointer">
				<span class="block">
					<span class="block font-bold">Analytické</span>
					<span class="block text-white/80 text-xs mt-1">Google Analytics – anonymizovaná statistika návštěvnosti webu (Google Ireland Limited).</span>
				</span>
				<input id="cookie-analytics" type="checkbox" class="mt-1 h-5 w-5 shrink-0 accent-[#d4af37] cursor-pointer" />
			</label>
		</div>

		<div class="mt-5 flex flex-col sm:flex-row flex-wrap gap-3 sm:justify-end">
			<button type="button" data-cookie-action="settings" id="cookie-settings-btn" aria-expanded="false" aria-controls="cookie-settings-panel" class="px-5 py-3 rounded-full border border-white/40 text-xs font-bold uppercase tracking-widest hover:border-[#d4af37] hover:text-[#d4af37] transition-colors cursor-pointer">Nastavení</button>
			<button type="button" data-cookie-action="save" id="cookie-save-btn" class="hidden px-5 py-3 rounded-full border border-[#d4af37] text-[#d4af37] text-xs font-bold uppercase tracking-widest hover:bg-[#d4af37] hover:text-[#0a192f] transition-colors cursor-pointer">Uložit výběr</button>
			<button type="button" data-cookie-action="reject" class="px-5 py-3 rounded-full bg-white text-[#0a192f] text-xs font-bold uppercase tracking-widest hover:bg-slate-200 transition-colors cursor-pointer">Odmítnout vše</button>
			<button type="button" data-cookie-action="accept" class="px-5 py-3 rounded-full bg-[#d4af37] text-[#0a192f] text-xs font-bold uppercase tracking-widest hover:bg-white transition-colors cursor-pointer">Přijmout vše</button>
		</div>
	</div>
</div>

<script>
	import { COOKIE_CONSENT_KEY as STORAGE_KEY } from '../lib/legal';

	type Consent = { necessary: true; analytics: boolean; ts: string; v: 1 };

	const GA_ID = 'G-5JPLYYKGGN';

	function readConsent(): Consent | null {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw);
			return parsed && typeof parsed.analytics === 'boolean' ? (parsed as Consent) : null;
		} catch {
			return null;
		}
	}

	function writeConsent(analytics: boolean) {
		const consent: Consent = { necessary: true, analytics, ts: new Date().toISOString(), v: 1 };
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
		} catch {
			/* localStorage nedostupné – volba platí jen pro tuto stránku */
		}
		applyConsent(consent);
	}

	let gaLoaded = false;

	function loadAnalytics() {
		(window as any)[`ga-disable-${GA_ID}`] = false;
		if (gaLoaded) return;
		gaLoaded = true;
		const w = window as any;
		w.dataLayer = w.dataLayer || [];
		w.gtag = function () {
			w.dataLayer.push(arguments);
		};
		const script = document.createElement('script');
		script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
		script.async = true;
		script.onload = () => {
			w.gtag('js', new Date());
			w.gtag('config', GA_ID, { anonymize_ip: true });
		};
		document.head.appendChild(script);
	}

	function removeAnalyticsCookies() {
		const host = location.hostname;
		const domains = [host, `.${host}`, `.${host.split('.').slice(-2).join('.')}`];
		document.cookie.split(';').forEach((c) => {
			const name = c.split('=')[0].trim();
			if (name === '_ga' || name.startsWith('_ga_') || name === '_gid' || name.startsWith('_gat')) {
				domains.forEach((d) => {
					document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=${d}`;
				});
				document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
			}
		});
	}

	function applyConsent(consent: Consent) {
		if (consent.analytics) {
			loadAnalytics();
		} else {
			(window as any)[`ga-disable-${GA_ID}`] = true;
			removeAnalyticsCookies();
		}
		hideBanner();
	}

	const el = {
		banner: () => document.getElementById('cookie-banner'),
		panel: () => document.getElementById('cookie-settings-panel'),
		analytics: () => document.getElementById('cookie-analytics') as HTMLInputElement | null,
		settingsBtn: () => document.getElementById('cookie-settings-btn'),
		saveBtn: () => document.getElementById('cookie-save-btn'),
	};

	function togglePanel(open: boolean) {
		el.panel()?.classList.toggle('hidden', !open);
		el.saveBtn()?.classList.toggle('hidden', !open);
		el.settingsBtn()?.setAttribute('aria-expanded', String(open));
	}

	function showBanner(openSettings = false) {
		const consent = readConsent();
		const analytics = el.analytics();
		if (analytics) analytics.checked = !!consent?.analytics;
		togglePanel(openSettings);
		el.banner()?.classList.remove('hidden');
	}

	function hideBanner() {
		el.banner()?.classList.add('hidden');
	}

	// Delegované události – navázané jen jednou, přežijí i přechody mezi stránkami (View Transitions).
	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		if (!target) return;

		if (target.closest('[data-open-cookie-settings]')) {
			event.preventDefault();
			showBanner(true);
			return;
		}

		const actionEl = target.closest('[data-cookie-action]') as HTMLElement | null;
		if (!actionEl) return;
		switch (actionEl.dataset.cookieAction) {
			case 'accept':
				writeConsent(true);
				break;
			case 'reject':
				writeConsent(false);
				break;
			case 'save':
				writeConsent(!!el.analytics()?.checked);
				break;
			case 'settings':
				togglePanel(el.panel()?.classList.contains('hidden') ?? true);
				break;
		}
	});

	(window as any).openCookieSettings = () => showBanner(true);

	document.addEventListener('astro:page-load', () => {
		const consent = readConsent();
		if (!consent) {
			showBanner(false);
		} else if (consent.analytics) {
			loadAnalytics();
		}
	});
</script>
