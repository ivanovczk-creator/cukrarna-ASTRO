---
// Jednotná patička pro všechny stránky: identifikace prodávajícího, právní odkazy, platební metody.
import PaymentIcons from './PaymentIcons.astro';
import { COMPANY, LEGAL_PAGES, STORES } from '../lib/legal';

const year = new Date().getFullYear();
const legalLinks = [
	{ href: LEGAL_PAGES.terms, label: 'Obchodní podmínky' },
	{ href: LEGAL_PAGES.privacy, label: 'Ochrana osobních údajů' },
	{ href: LEGAL_PAGES.payments, label: 'Platební metody' },
	{ href: LEGAL_PAGES.cookies, label: 'Zásady cookies' },
];
---

<footer class="bg-[#0a192f] py-14 text-white border-t border-[#d4af37]/10">
	<div class="max-w-7xl mx-auto px-4">
		<div class="grid gap-10 md:grid-cols-3 text-left text-sm leading-relaxed">
			<div>
				<p class="italic text-[#d4af37] text-lg font-serif font-bold mb-3">{COMPANY.shortName}</p>
				<p class="font-bold">{COMPANY.tradeName}</p>
				<p>IČO: {COMPANY.ico}</p>
				<p>{COMPANY.vatStatus}</p>
				<p>Sídlo: {COMPANY.address}</p>
				<p>
					Tel.: <a href={`tel:${COMPANY.phone.replace(/\s/g, '')}`} class="hover:text-[#d4af37] transition-colors">{COMPANY.phone}</a>
				</p>
				<p>
					E-mail: <a href={`mailto:${COMPANY.email}`} class="hover:text-[#d4af37] transition-colors">{COMPANY.email}</a>
				</p>
				<p class="mt-3 text-xs opacity-80">Fyzická osoba zapsaná v živnostenském rejstříku. Tradiční rodinné cukrářství od roku 1991.</p>
			</div>

			<div>
				<p class="uppercase tracking-widest text-[11px] text-[#d4af37] font-bold mb-3">Výdejní prodejny</p>
				<ul class="space-y-2 list-none p-0 m-0">
					{STORES.map((store) => (
						<li>
							<span class="font-bold">{store.name}</span><br />
							{store.address}<br />
							<a href={`tel:${store.phone.replace(/\s/g, '')}`} class="hover:text-[#d4af37] transition-colors">{store.phone}</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p class="uppercase tracking-widest text-[11px] text-[#d4af37] font-bold mb-3">Informace</p>
				<ul class="space-y-2 list-none p-0 m-0">
					{legalLinks.map((link) => (
						<li><a href={link.href} class="hover:text-[#d4af37] transition-colors">{link.label}</a></li>
					))}
					<li>
						<button type="button" data-open-cookie-settings class="hover:text-[#d4af37] transition-colors underline-offset-2 hover:underline cursor-pointer bg-transparent border-0 p-0 text-inherit font-inherit text-left">Nastavení cookies</button>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-10 pt-8 border-t border-white/10 flex flex-col items-center gap-4">
			<p class="uppercase tracking-widest text-[10px] text-white/70 font-bold">Platba kartou a online – bezpečně přes Comgate</p>
			<PaymentIcons />
		</div>

		<div class="mt-8 text-center text-[11px] text-white/70 tracking-wide">
			<p>© {year} {COMPANY.tradeName} — Všechna práva vyhrazena</p>
			<a href="https://objednavky.cukrarstviblahutovi.cz/login" target="_blank" rel="noopener noreferrer" class="hover:text-[#d4af37] transition-colors mt-2 inline-block opacity-80">Přihlášení pro partnery</a>
		</div>
	</div>
</footer>
