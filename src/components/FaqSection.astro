---
// Viditelná sekce „Časté dotazy“ + FAQPage JSON-LD (obsah ve strukturovaných datech musí být vidět i na stránce).
import JsonLd from './JsonLd.astro';
import { faqNode, graph, type FaqItem } from '../lib/seo';

interface Props {
	items: FaqItem[];
	title?: string;
	class?: string;
}
const { items, title = 'Časté dotazy', class: className = '' } = Astro.props;
---

<section class={`bg-white rounded-[2.5rem] border border-slate-100 shadow-sm p-8 md:p-12 max-w-4xl ${className}`} aria-labelledby="faq-title">
	<h2 id="faq-title" class="text-2xl md:text-3xl font-serif italic text-[#0a192f] mb-6 font-bold">{title}</h2>
	<div class="divide-y divide-slate-100">
		{items.map((item) => (
			<details class="group py-4">
				<summary class="cursor-pointer list-none flex justify-between items-start gap-4 text-[#0a192f] font-bold text-base md:text-lg">
					<span>{item.question}</span>
					<span class="text-[#d4af37] shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
				</summary>
				<p class="mt-3 text-slate-700 leading-relaxed font-normal text-base">{item.answer}</p>
			</details>
		))}
	</div>
	<JsonLd data={graph(faqNode(items))} />
</section>
