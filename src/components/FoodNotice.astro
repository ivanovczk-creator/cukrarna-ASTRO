---
// Krátké upozornění pod nabídkou potravin: rychlá zkáza, skladování, alergeny.
// subtle = decentní poznámka pod výpisem produktů (bez rámečku), jinak výrazný žlutý box.
import { LEGAL_PAGES, PERISHABLE_NOTICE } from '../lib/legal';
interface Props {
	class?: string;
	subtle?: boolean;
}
const { class: className = '', subtle = false } = Astro.props;
const baseClass = subtle
	? 'max-w-3xl mx-auto border-t border-cream-300 pt-6 text-xs text-zinc-600 font-bold leading-relaxed text-center'
	: 'max-w-3xl mx-auto bg-blush-100 border border-blush-300 rounded-2xl p-5 text-sm text-zinc-800 font-bold leading-relaxed';
---

<aside class={`${baseClass} ${className}`}>
	<p>
		<span aria-hidden="true">❄️</span> {PERISHABLE_NOTICE}
	</p>
	<p class="mt-2">
		Výrobky mohou obsahovat alergeny (č. 1–14). Přehled alergenů najdete v
		<a href={`${LEGAL_PAGES.terms}#alergeny`} class="underline text-berry-700 hover:text-zinc-900">obchodních podmínkách</a>.
	</p>
</aside>
