---
// Krátké upozornění pod nabídkou potravin: rychlá zkáza, skladování, alergeny.
import { LEGAL_PAGES, PERISHABLE_NOTICE } from '../lib/legal';
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<aside class={`max-w-3xl mx-auto bg-amber-50 border border-amber-200 rounded-2xl p-5 text-sm text-slate-800 font-bold leading-relaxed ${className}`}>
	<p>
		<span aria-hidden="true">❄️</span> {PERISHABLE_NOTICE}
	</p>
	<p class="mt-2">
		Výrobky mohou obsahovat alergeny (č. 1–14). Přehled alergenů najdete v
		<a href={`${LEGAL_PAGES.terms}#alergeny`} class="underline text-[#735c1e] hover:text-[#0a192f]">obchodních podmínkách</a>.
	</p>
</aside>
