---
// Textový blok pod nabídkou (unikátní popis stránky pro čtenáře i vyhledávače).
interface Props {
	title: string;
	paragraphs: string[];
	points?: string[];
	class?: string;
}
const { title, paragraphs, points = [], class: className = '' } = Astro.props;
---

<section class={`bg-white rounded-[2.5rem] border border-slate-100 shadow-sm p-8 md:p-12 max-w-4xl ${className}`}>
	<h2 class="text-2xl md:text-3xl font-serif italic text-[#0a192f] mb-6 font-bold">{title}</h2>
	<div class="space-y-4 text-slate-700 leading-relaxed font-normal text-base md:text-lg">
		{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
	</div>
	{points.length > 0 && (
		<ul class="mt-6 space-y-2 text-slate-700 font-normal text-base list-disc pl-6 marker:text-[#d4af37]">
			{points.map((point) => <li>{point}</li>)}
		</ul>
	)}
</section>
